---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="走丢了 · Gardenia" description="这个页面不存在。">
  <main class="lost" id="main" tabindex="-1">
    <div class="lost__inner">
      <p class="lost__code" aria-hidden="true">404</p>
      <h1 class="lost__title">走丢了</h1>
      <a class="lost__link" href="/">回到首页</a>
    </div>
  </main>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: var(--section-y) var(--gutter);
    text-align: center;
  }

  .lost::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(680px, 90vw);
    height: 420px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 178, 74, 0.1), transparent 66%);
    pointer-events: none;
  }

  .lost__inner {
    position: relative;
  }

  .lost__code {
    font-family: var(--font-display);
    font-size: clamp(64px, 14vw, 128px);
    line-height: 1;
    letter-spacing: 0.08em;
    color: rgba(255, 178, 74, 0.22);
  }

  .lost__title {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 400;
    letter-spacing: 0.16em;
    color: var(--cream);
    text-shadow: 0 0 44px rgba(255, 178, 74, 0.16);
  }

  .lost__link {
    display: inline-block;
    margin-top: 42px;
    padding: 10px 18px;
    border: 1px solid rgba(246, 231, 211, 0.16);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: rgba(201, 174, 149, 0.86);
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .lost__link:hover {
    color: var(--amber-soft);
    border-color: rgba(255, 178, 74, 0.35);
    background: rgba(255, 178, 74, 0.06);
  }
</style>
