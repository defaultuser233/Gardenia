---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import CursorGlow from '../components/atmosphere/CursorGlow.tsx';
---

<BaseLayout>
  <SiteNav />
  <main>
    <Hero />
    <About />
  </main>
  <SiteFooter />
  <CursorGlow client:load />
</BaseLayout>

<style>
  :global(.cursor-glow) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: 640px;
    height: 640px;
    margin: -320px 0 0 -320px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 178, 74, 0.18) 0%,
      rgba(226, 104, 60, 0.07) 42%,
      transparent 68%
    );
    mix-blend-mode: screen;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
  }

  :global(.cursor-glow.is-on) {
    opacity: 1;
  }
</style>
